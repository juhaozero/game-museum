# 站点 Origin（无尾斜杠、不含路由后缀），用于 canonical / OG（预留）
PUBLIC_SITE_URL=http://localhost:5173

# 路由后缀 / 子路径（可选）。例如 /museum → 挂在 https://域名/museum
# 留空则挂在域名根路径。修改后需重启 dev / 重新 build
PUBLIC_ROUTE_SUFFIX=

# UI 显示开关（true/false、1/0、yes/no、on/off）。修改后需重启 dev / 重新 build
# 截图网格悬停标题、Lightbox 侧栏是否显示文件名（默认 false）
PUBLIC_SHOW_IMAGE_FILENAME=false
# 收藏等多游戏列表悬停标题是否显示游戏名（默认 true）
PUBLIC_SHOW_SCREENSHOT_GAME_NAME=true
